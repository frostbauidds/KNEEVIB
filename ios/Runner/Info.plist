<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ios/Runner/Info.plist additions for KneeVib -->
<!-- Add these keys to the existing Info.plist generated by Flutter. -->
<plist version="1.0">
<dict>
    <!-- App name -->
    <key>CFBundleName</key>
    <string>KneeVib</string>

    <!-- ── BLE permissions ── -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>KneeVib uses Bluetooth to connect to the knee wearable device.</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>KneeVib connects to the knee monitor over Bluetooth.</string>

    <!-- ── Location (required for BLE scanning on iOS) ── -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Location access is required to scan for nearby Bluetooth devices.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Location access is required to scan for nearby Bluetooth devices.</string>

    <!-- ── Local network (for hotspot HTTP calls) ── -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>KneeVib needs to connect to the device hotspot to download session recordings.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_kneevib._tcp</string>
    </array>

    <!-- ── Wi-Fi hotspot (NEHotspotConfiguration) ── -->
    <!-- Requires the Wireless Accessory Configuration capability in Xcode. -->
    <!-- Add the capability in Xcode > Signing & Capabilities > + Capability -->

    <!-- Background modes: allow reconnect after recording -->
    <key>UIBackgroundModes</key>
    <array>
        <string>bluetooth-central</string>
    </array>

    <!-- Arbitrary loads for the ESP32 plain-HTTP hotspot -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>192.168.4.1</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
                <key>NSIncludesSubdomains</key>
                <false/>
            </dict>
        </dict>
    </dict>
</dict>
</plist>
